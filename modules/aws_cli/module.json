  "commands": [
    {
      "name": "codepipeline_get_state",
      "description": "Read the state of a CodePipeline pipeline: each stage and its latest execution.",
      "classes": [
        "egress"
      ],
      "timeoutMs": 60000,
      "prefix": [
        "codepipeline",
        "get-pipeline-state"
      ],
      "fixed": [
        "--region",
        "us-east-1",
        "--output",
        "json"
      ],
      "arguments": {
        "pipeline": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.@_-]{0,99}$",
          "option": "--name",
          "description": "The pipeline's name"
        }
      }
    },
    {
      "name": "codepipeline_retry_stage",
      "description": "Retry the failed actions of a pipeline stage. It changes the pipeline: the user approves each call before it is made.",
      "classes": [
        "egress",
        "consequential"
      ],
      "timeoutMs": 60000,
      "prefix": [
        "codepipeline",
        "retry-stage-execution"
      ],
      "fixed": [
        "--region",
        "us-east-1",
        "--output",
        "json",
        "--retry-mode",
        "FAILED_ACTIONS"
      ],
      "arguments": {
        "pipeline": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.@_-]{0,99}$",
          "option": "--pipeline-name",
          "description": "The pipeline's name"
        },
        "stage": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.@_-]{0,99}$",
          "option": "--stage-name",
          "description": "The stage to retry"
        },
        "execution": {
          "type": "string",
          "pattern": "^[0-9a-f-]{36}$",
          "option": "--pipeline-execution-id",
          "description": "The pipeline execution's id"
        }
      }
    },
    {
      "name": "s3_upload",
      "description": "Upload a file from /channel or a named root to an S3 bucket whose name begins asha-demo-.",
      "classes": [
        "egress"
      ],
      "timeoutMs": 120000,
      "prefix": [
        "s3",
        "cp"
      ],
      "fixed": [
        "--region",
        "us-east-1",
        "--only-show-errors"
      ],
      "arguments": {
        "source": {
          "type": "path",
          "mode": "read",
          "description": "The file to upload"
        },
        "destination": {
          "type": "remote",
          "pattern": "^s3://asha-demo-[a-z0-9-]{1,40}/[A-Za-z0-9._/-]{1,200}$",
          "description": "Where: s3://asha-demo-<name>/<key>"
        }
      }
    }
  ]
}
