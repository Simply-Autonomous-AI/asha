{
  "compilerOptions": {
    "target": "ES2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2024", "ES2025.Iterator", "ES2025.Collection"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "images/*/src/**/*.ts", "evals/**/*.ts", "tools/**/*.mts", "tests/**/*.ts", "*.config.mts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/portal",
    "tests/**/*.dom.test.ts",
    "tests/helpers/fake-dom.ts",
    "tests/helpers/fake-canvas.ts"
  ]
}
