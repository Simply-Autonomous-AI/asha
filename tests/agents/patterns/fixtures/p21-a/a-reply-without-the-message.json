{
  "scenario": "p21-a",
  "breaks": "two outputs, one from each of weather-desk-1 and front-page-1, each \"<its handle> noted:\" and the message",
  "note": "front-page-1's reply does not hold the message.",
  "team": "topics",
  "input": {
    "user": "alice",
    "to": null,
    "text": "Rain expected tomorrow.",
    "topic": "weather"
  },
  "recipients": [
    "weather-desk-1",
    "front-page-1"
  ],
  "messages": [
    {
      "from": "weather-desk-1",
      "kind": "status",
      "text": "ok",
      "working": [
        "weather-desk-1",
        "front-page-1"
      ]
    },
    {
      "from": "front-page-1",
      "kind": "status",
      "text": "ok",
      "working": [
        "weather-desk-1",
        "front-page-1"
      ]
    },
    {
      "from": "weather-desk-1",
      "kind": "output",
      "text": "weather-desk-1 noted: Rain expected tomorrow.",
      "working": [
        "front-page-1"
      ]
    },
    {
      "from": "front-page-1",
      "kind": "output",
      "text": "front-page-1 noted: something else",
      "working": []
    }
  ],
  "ms": 6000
}
