{
  "scenario": "p02-b",
  "breaks": "exactly one internal message, router-1 → desk-b-1, containing 17 and 25",
  "note": "router-1 sends the request to desk-a-1 as well.",
  "team": "router",
  "input": {
    "user": "alice",
    "to": "router-1",
    "text": "What is 17 plus 25?"
  },
  "recipients": [
    "router-1"
  ],
  "messages": [
    {
      "from": "router-1",
      "kind": "status",
      "text": "ok"
    },
    {
      "from": "router-1",
      "kind": "internal",
      "text": "Add 17 and 25.",
      "to": "desk-b-1",
      "working": [
        "router-1",
        "desk-b-1"
      ]
    },
    {
      "from": "router-1",
      "kind": "internal",
      "text": "Add 17 and 25.",
      "to": "desk-a-1",
      "working": [
        "router-1",
        "desk-b-1",
        "desk-a-1"
      ]
    },
    {
      "from": "desk-b-1",
      "kind": "status",
      "text": "ok"
    },
    {
      "from": "desk-b-1",
      "kind": "output",
      "text": "42"
    }
  ],
  "ms": 5000
}
