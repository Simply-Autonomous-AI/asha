{
  "scenario": "p03-a",
  "breaks": "\"red\" appears in exactly one member's document, stage-a.md",
  "note": "stage-b also knows red: the first stage is no longer needed for it.",
  "team": "pipeline",
  "input": {
    "user": "alice",
    "to": "stage-a-1",
    "text": "Build the colour list."
  },
  "recipients": [
    "stage-a-1"
  ],
  "messages": [
    {
      "from": "stage-a-1",
      "kind": "status",
      "text": "ok"
    },
    {
      "from": "stage-a-1",
      "kind": "internal",
      "text": "list: red",
      "to": "stage-b-1",
      "working": [
        "stage-a-1",
        "stage-b-1"
      ]
    },
    {
      "from": "stage-b-1",
      "kind": "status",
      "text": "ok"
    },
    {
      "from": "stage-b-1",
      "kind": "internal",
      "text": "list: red, orange",
      "to": "stage-c-1",
      "working": [
        "stage-b-1",
        "stage-c-1"
      ]
    },
    {
      "from": "stage-c-1",
      "kind": "status",
      "text": "ok"
    },
    {
      "from": "stage-c-1",
      "kind": "output",
      "text": "list: red, orange, yellow"
    }
  ],
  "ms": 12000,
  "teamFiles": {
    "stage-b.md": "1. On a message from stage-a-1 starting \"list:\", call send_message to stage-c-1 with the same text followed by \", orange\".\n2. Never call reply.\nThe list starts with red.\n"
  }
}
