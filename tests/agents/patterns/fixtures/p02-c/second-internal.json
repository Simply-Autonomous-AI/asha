{
  "scenario": "p02-c",
  "breaks": "exactly one internal message, router-1 → desk-c-1, asking for Hello World",
  "note": "router-1 sends the request to desk-a-1 as well.",
  "team": "router",
  "input": {
    "user": "alice",
    "to": "router-1",
    "text": "Please have the right agent say: Hello World."
  },
  "recipients": [
    "router-1"
  ],
  "messages": [
    {
      "from": "router-1",
      "kind": "status",
      "text": "ok"
    },
    {
      "from": "router-1",
      "kind": "internal",
      "text": "Say: Hello World",
      "to": "desk-c-1",
      "working": [
        "router-1",
        "desk-c-1"
      ]
    },
    {
      "from": "router-1",
      "kind": "internal",
      "text": "Say: Hello World",
      "to": "desk-a-1",
      "working": [
        "router-1",
        "desk-c-1",
        "desk-a-1"
      ]
    },
    {
      "from": "desk-c-1",
      "kind": "status",
      "text": "ok"
    },
    {
      "from": "desk-c-1",
      "kind": "output",
      "text": "Hello World"
    }
  ],
  "ms": 5000
}
